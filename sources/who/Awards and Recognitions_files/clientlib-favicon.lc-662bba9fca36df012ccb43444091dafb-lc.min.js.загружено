(function() {
    'use strict';

    // Function to execute when the DOM is fully loaded
    function onDomReady() {
        // Initial run
        updateFavicon();

        // Theme change detection
        const darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
        if (darkModeQuery.addEventListener) {
            darkModeQuery.addEventListener('change', updateFavicon);
        } else if (darkModeQuery.addListener) {
            darkModeQuery.addListener(updateFavicon);
        }
    }
    
    function updateFavicon() {
        const isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const favicon = document.getElementById('favicon');
        //const pagid_favicon = document.getElementById('pagid_favicon');
        if (favicon) {
          favicon.href = isDarkMode
            ? '/content/dam/components/fav-icons/dark-mode-favicon.ico'
            : '/content/dam/components/fav-icons/favicon.ico';
        } /*else if (pagid_favicon) {
                        pagid_favicon.href = isDarkMode
                          ? '/content/dam/components/fav-icons/pagid/dark-mode-favicon.ico'
                          : '/content/dam/components/fav-icons/pagid/favicon.ico';
                      }*/
      }

    // Check if the document is already loaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', onDomReady);
    } else {
        onDomReady();
    }
})();

